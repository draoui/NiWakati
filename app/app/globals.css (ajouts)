@tailwind base;
@tailwind components;
@tailwind utilities;
 
@layer base {
  :root {
    /* Palette de couleurs principale */
    --primary: 221.2 83.2% 53.3%;
    --primary-foreground: 210 40% 98%;
    
    /* Couleurs secondaires et d'accent */
    --secondary: 210 40% 96.1%;
    --secondary-foreground: 222.2 47.4% 11.2%;
    --accent: 210 40% 96.1%;
    --accent-foreground: 222.2 47.4% 11.2%;
    
    /* Couleurs de fond et de texte */
    --background: 0 0% 100%;
    --foreground: 222.2 84% 4.9%;
    
    /* Autres variables */
    --card: 0 0% 100%;
    --card-foreground: 222.2 84% 4.9%;
    --popover: 0 0% 100%;
    --popover-foreground: 222.2 84% 4.9%;
    --muted: 210 40% 96.1%;
    --muted-foreground: 215.4 16.3% 46.9%;
    --destructive: 0 84.2% 60.2%;
    --destructive-foreground: 210 40% 98%;
    --border: 214.3 31.8% 91.4%;
    --input: 214.3 31.8% 91.4%;
    --ring: 221.2 83.2% 53.3%;
    --radius: 0.75rem;
  }
 
  .dark {
    /* Dark mode colors */
    --background: 222.2 84% 4.9%;
    --foreground: 210 40% 98%;
    /* ... autres couleurs dark mode ... */
  }
}

/* Styles globaux */
.section-padding {
  @apply py-16 md:py-24;
}

.container {
  @apply px-4 mx-auto max-w-7xl;
}

.hero-section {
  @apply relative min-h-[60vh] flex items-center justify-center;
}

.hero-overlay {
  @apply absolute inset-0 bg-gradient-to-b from-black/60 to-black/30;
}

.card-hover {
  @apply transition-all duration-300 hover:shadow-lg hover:-translate-y-1;
}

.link-hover {
  @apply transition-colors duration-200 hover:text-primary;
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fadeIn {
  animation: fadeIn 0.5s ease-out forwards;
}